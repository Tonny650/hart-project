---
import Mark from '../assets/logo-mark.svg';

interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<span class="logo">
  <Mark height={size} width={Math.round(size * 1.48)} aria-hidden="true" />
  <span class="word">HART</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .word {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
</style>
